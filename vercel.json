{
  "functions": {
    "api/public/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
   },
   "routes":[
      
    {
        "src":"/actions/(.*)", "dest":"/api/public/index.php?route=actions/$1"
    },
    {
    "src": "/(.*)\\.php", "dest": "api/public/index.php?route=$1" },
    {
        "src":"/(.*)", "dest": "/api/public/$1"    }
    ]
}